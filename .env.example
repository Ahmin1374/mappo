# Copy to .env and fill in. Never commit .env.

# PostgreSQL / PostGIS
DB_PASSWORD=change-me
# pgAdmin web UI (http://localhost:5050)
PGADMIN_PASSWORD=change-me

# JWT signing key - at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: creates demo users admin / broker / viewer / testuser with this password
DEMO_USER_PASSWORD=
